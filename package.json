{
  "name": "nahida-nana-toolkit-workspace",
  "private": true,
  "version": "0.1.2",
  "scripts": {
    "dev:desktop": "pnpm --filter @nahida-nana/desktop exec -- tauri dev",
    "build:desktop": "pnpm --filter @nahida-nana/desktop exec -- tauri build",
    "dev:web": "pnpm --filter @nahida-nana/web exec -- vite",
    "build:web": "pnpm --filter @nahida-nana/web exec -- vite build",
    "clean:rust": "cd packages/desktop/src-tauri && cargo clean",
    "clean:store": "pnpm store prune",
    "clean:all": "pnpm run clean:rust && pnpm run clean:store"
  },
  "devDependencies": {
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "vue-tsc": "^2.1.10"
  }
}